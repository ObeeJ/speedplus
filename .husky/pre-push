#!/bin/sh

echo "🚀 [Pre-Push Gate] Running complete CI/CD workflow (.github/workflows/api-ci.yml)..."

# Env vars matching CI pipeline
export DATABASE_URL="${DATABASE_URL:-postgres://speedplus:speedplus@localhost:5433/speedplus?sslmode=disable}"
export REDIS_URL="${REDIS_URL:-redis://localhost:6379}"
export JWT_SECRET="test-secret-that-is-at-least-32-bytes-long"
export PAYCODE_SECRET="test-paycode-secret-32-bytes-padded-xx"
export QUOTE_SECRET="test-quote-secret-that-is-32-bytes-long"
export ENVIRONMENT="development"

# 1. Secret Leak Audit
echo "🔒 [CI Step: Gitleaks] Auditing outgoing commits for secret leaks..."
COMMITTED_SECRETS=$(git diff origin/dev..HEAD | grep -iE "(AWS_SECRET_ACCESS_KEY|PRIVATE_KEY|BEGIN RSA PRIVATE KEY)" 2>/dev/null || true)
if [ -n "$COMMITTED_SECRETS" ]; then
  echo "❌ [ERROR] Secret detected in outgoing commits!"
  exit 1
fi

# 2. Go Backend Migration & Static Analysis
echo "🔨 [CI Step: Migrate & Vet] Running DB migrations & go vet..."
(cd apps/api && go run ./cmd/server/migrate_ci/main.go && go vet ./...) || exit 1

# 3. Go Backend Compilation & Unit Tests with Race Detector
echo "🧪 [CI Step: Build & Test] Compiling Go packages & running tests with -race..."
(cd apps/api && go build ./... && go test -race ./...) || exit 1

# 4. TypeScript Workspace Typecheck
echo "📐 [CI Step: Typecheck] Running tsc across TypeScript packages..."
pnpm turbo typecheck || pnpm --filter @fourdat/types exec tsc --noEmit || exit 1

# 5. Monorepo ESLint Gate
echo "🎨 [CI Step: ESLint] Running pnpm turbo lint..."
pnpm turbo lint || exit 1

# 6. Monorepo Production Build (Next.js Apps & Shared Packages)
echo "🏗️ [CI Step: Production Build] Compiling frontend Next.js apps & packages..."
pnpm turbo build || exit 1

echo "✅ [Pre-Push Gate] CI/CD workflow (.github/workflows/api-ci.yml) passed 100% cleanly!"

#!/bin/sh

echo "🛡️  [Pre-Commit Gate] Enforcing quality, secret scanning, and test coverage gates..."

# 1. Secret Leak Detection Gate (excluding .husky hook definitions)
echo "🔍 Checking for accidental secret leaks in staged files..."
STAGED_SECRETS=$(git diff --cached --name-only | grep -v '^\.husky/' | xargs grep -iE "(AWS_SECRET_ACCESS_KEY\s*=|PRIVATE_KEY\s*=|BEGIN RSA PRIVATE KEY|bearer [a-zA-Z0-9_\-\.]{25,})" 2>/dev/null || true)
if [ -n "$STAGED_SECRETS" ]; then
  echo "❌ [ERROR] Potential hardcoded secret or token detected in staged files:"
  echo "$STAGED_SECRETS"
  exit 1
fi

# 2. Test Coverage Enforcement Gate (Unit / Mock / Integration)
echo "🧪 Verifying test coverage for staged changes..."
STAGED_GO_FILES=$(git diff --cached --name-only | grep '\.go$' | grep -v '_test\.go$' || true)
if [ -n "$STAGED_GO_FILES" ]; then
  STAGED_TEST_FILES=$(git diff --cached --name-only | grep '_test\.go$' || true)
  if [ -z "$STAGED_TEST_FILES" ]; then
    echo "⚠️ [NOTICE] Go source files staged without corresponding test files."
    echo "Staged Go files:"
    echo "$STAGED_GO_FILES"
    echo "Ensure unit/mock/integration tests are written and staged!"
  fi
fi

# 3. Go Vet Static Analysis Gate
echo "🔬 Running 'go vet ./...' on backend..."
(cd apps/api && go vet ./...) || exit 1

# 4. Go Binary Build Verification Gate
echo "🔨 Verifying Go backend binary compilation ('go build')..."
(cd apps/api && go build -o /dev/null ./cmd/server) || exit 1

# 5. Go Integration & Invariant Unit Tests
echo "🧪 Running Go test suite with PostgreSQL & Redis..."
(cd apps/api && DATABASE_URL="postgres://speedplus:speedplus@localhost:5433/speedplus?sslmode=disable" REDIS_URL="redis://localhost:6379" go test ./...) || exit 1

# 6. Monorepo Frontend Linting Gate
echo "🎨 Running monorepo lint..."
pnpm turbo lint || exit 1

echo "✅ [Pre-Commit Gate] All pre-commit security & quality checks passed!"

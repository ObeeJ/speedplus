#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Block commits containing secrets (gitleaks must be installed: brew install gitleaks)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --redact -v
  if [ $? -ne 0 ]; then
    echo "❌ gitleaks: potential secret detected in staged files. Commit blocked."
    exit 1
  fi
else
  echo "⚠️  gitleaks not installed — secret scan skipped. Install: brew install gitleaks"
fi

# Block .env files from being committed
if git diff --cached --name-only | grep -qE '\.env($|\.|\.local|\.production)'; then
  echo "❌ Attempted to commit an .env file. Remove it from staging: git reset HEAD <file>"
  exit 1
fi

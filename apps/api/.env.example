# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development  # development | production

# ── Database (Supabase session-mode pooler :5432) ─────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<password>@<host>:6379

# ── JWT (must be >= 32 bytes of random entropy) ───────────────────────────────
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ── CORS (comma-separated) ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=speedplus-docs
R2_PUBLIC_URL=

# ── Prembly KYC ───────────────────────────────────────────────────────────────
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com  # use https://sandbox.prembly.com for sandbox

# ── Payment providers ─────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_<key>
PAYSTACK_WEBHOOK_HASH=
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-<key>
FLUTTERWAVE_HASH=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

# ── Bridge (feature-flagged) ──────────────────────────────────────────────────
BRIDGE_API_KEY=
BRIDGE_ENABLED=false

# ── SendByte (transactional email) ───────────────────────────────────────────
# Use sk_test_ key for development, sk_live_ for production.
# Never commit a real key here — read from Railway/env secrets at runtime.
SENDBYTE_API_KEY=sk_test_<your_key_here>
SENDBYTE_FROM_ADDRESS=SpeedPlus <noreply@speedplus.app>

# ── Routing ───────────────────────────────────────────────────────────────────
OSRM_URL=http://router.project-osrm.org

# ── Encryption (must be exactly 32 bytes) ────────────────────────────────────
# Required in ALL environments. Generate with: openssl rand -hex 16
ENCRYPTION_KEY=<generate: openssl rand -hex 16>

# ── Paycode signing (must be >= 32 bytes, MUST differ from JWT_SECRET) ────────
# Signs QR paycodes and SpeedPlus card payloads. Separate key = separate trust domain.
# Generate with: openssl rand -hex 32
PAYCODE_SECRET=<generate: openssl rand -hex 32>

# ── Business rules ────────────────────────────────────────────────────────────
PIN_THRESHOLD_KOBO=5000000  # ₦50,000 — require PIN above this amount
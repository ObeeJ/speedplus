#!/bin/sh
# Pre-commit: block secrets from entering the repo

if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks protect --staged --config=.gitleaks.toml -v; then
        echo "❌ gitleaks detected secrets. Commit blocked."
        echo "   Review the findings above and remove secrets before committing."
        echo "   Use environment variables instead — see apps/api/.env.example"
        exit 1
    fi
else
    echo "❌ gitleaks is not installed. Commit blocked."
    echo "   Install: https://github.com/gitleaks/gitleaks#installing"
    echo "   Or run: brew install gitleaks"
    exit 1
fi
